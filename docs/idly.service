# systemd unit for Idly Mail. Install as /etc/systemd/system/idly.service,
# then: systemctl daemon-reload && systemctl enable --now idly
# See docs/deploy.md.

[Unit]
Description=Idly Mail server
Documentation=file:///usr/local/share/doc/idly/deploy.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=idly
Group=idly
ExecStart=/usr/local/bin/idly --config /etc/idly/idly.toml serve
Restart=on-failure
RestartSec=5s
# Ports 25, 80, 443, 465 and 587 without running as root.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
# Hardening: the only writable place is the data directory.
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/idly
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
UMask=0077
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
